# Copy to .env and fill real values. .env is gitignored.

# ── HuggingFace (gated models: CONCHv1.5, TITAN, Llama-3.2-3B) ──
# Get token: https://huggingface.co/settings/tokens
# IMPORTANT: HF account primary email MUST be @itu.edu.tr (or other institutional).
# @gmail/@hotmail will be denied gated access.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ── Weights & Biases ──
# Get key: https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=patholens-vlm
WANDB_ENTITY=your-username-or-team

# ── RunPod connection ──
# Pod SSH info: RunPod console → Connect → SSH
RUNPOD_HOST=root@xxx-xxxxxxxx-xxxx.proxy.runpod.net
RUNPOD_PORT=22
REMOTE_DIR=/workspace/patholens-vlm

# ── CUDA ──
CUDA_VISIBLE_DEVICES=0

# ── Optional: GDC token for restricted TCGA access (public BRCA doesn't need) ──
# GDC_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Pre-commit auto-update ──
SKIP_PRECOMMIT_AUTOUPDATE=1
